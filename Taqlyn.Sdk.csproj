<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Taqlyn</RootNamespace>
    <AssemblyName>Taqlyn.Sdk</AssemblyName>
    <PackageId>Taqlyn.Sdk</PackageId>
    <Version>0.1.0</Version>
    <PackageVersion>0.1.0</PackageVersion>
    <Authors>Taqlyn</Authors>
    <Company>Taqlyn</Company>
    <Description>Taqlyn server SDK — Ed25519-signed short-link API</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://taqlyn.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/taqlyn/sdk-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>taqlyn;deep-links;shortlinks;ed25519</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Taqlyn.Sdk.Tests" />
  </ItemGroup>
  <!-- Nested test project would otherwise be compiled into the library. -->
  <ItemGroup>
    <Compile Remove="Taqlyn.Sdk.Tests/**" />
    <None Remove="Taqlyn.Sdk.Tests/**" />
    <EmbeddedResource Remove="Taqlyn.Sdk.Tests/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.5.1" />
  </ItemGroup>
</Project>
